{
  "name": "@cpvts/web",
  "version": "0.1.0",
  "private": true,
  "description": "CPVTS web client (React + TypeScript + Vite).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run build -w @cpvts/shared",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:android": "node scripts/prepare-android.mjs",
    "android:apk": "npm run build:android && node scripts/build-apk.mjs",
    "pretypecheck": "npm run build -w @cpvts/shared",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@cpvts/shared": "^0.1.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource-variable/noto-sans-kannada": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.53.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.16",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  }
}
