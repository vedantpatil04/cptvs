# Production defaults for `vite build` (Vercel and the Android APK). Public values only: these
# are embedded in the JavaScript bundle, so NEVER put a secret here.
#
# A VITE_API_BASE_URL (or VITE_API_URL) set in the build environment (Vercel project settings, CI, your shell)
# overrides this file.
VITE_API_BASE_URL=https://cptvs.onrender.com
VITE_API_URL=https://cptvs.onrender.com

