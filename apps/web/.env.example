# ---------------------------------------------------------------------------
# CPVTS web — environment variables (Vite)
# Copy to `.env.local` for local development. Values are embedded in the
# public JavaScript bundle at build time: NEVER put secrets here.
# ---------------------------------------------------------------------------

# Base URL of the CPVTS API (no trailing slash, no /api suffix).
VITE_API_URL=http://localhost:4000

# --- Branding (configurable per deployment) --------------------------------
VITE_BRAND_SHORT_NAME=CPVTS
VITE_BRAND_PRODUCT_NAME=Campus Parking & Vehicle Tracking System
VITE_BRAND_INSTITUTION_NAME=Bharatesh Institute of Technology, Belagavi
# Shows a notice that this is a demonstration deployment, not an official
# institutional system. Set to false only when the institution has authorised it.
VITE_BRAND_SHOW_DEMO_NOTICE=true

# Initial language when the user has not chosen one: en | kn | hi | mr
VITE_DEFAULT_LOCALE=en

# --- Photography (optional) ------------------------------------------------
# Real campus / parking photos. Use a path under apps/web/public (for example
# /images/hero.jpg) or an https URL. While a variable is empty, the page shows
# a designed placeholder instead - no stock photography is bundled.
VITE_IMAGE_HERO=
VITE_IMAGE_TWO_WHEELER_BLOCK=
VITE_IMAGE_FOUR_WHEELER_BLOCK=
VITE_IMAGE_CAMPUS=
