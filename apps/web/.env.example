# ---------------------------------------------------------------------------
# CPVTS web — environment variables (Vite)
# Copy to `.env.local` for local development. Values are embedded in the
# public JavaScript bundle at build time: NEVER put secrets here.
# ---------------------------------------------------------------------------

# Base URL of the CPVTS API: the origin only, no trailing slash and no /api/v1
# (the client appends /api/v1/... itself).
#
#   Local development:  http://localhost:4000   (used by `npm run dev`)
#   Production:         https://<your-render-service>.onrender.com
#                       Committed as the production default in `.env.production`; set the same
#                       variable in Vercel (Project → Settings → Environment Variables) to
#                       override it per environment.
#
# Production and Android builds never fall back to localhost: a build without a URL fails, and
# `npm run build:android` refuses localhost / private-network URLs.
VITE_API_BASE_URL=http://localhost:4000

# Legacy alias of VITE_API_BASE_URL (still read if VITE_API_BASE_URL is not set).
# VITE_API_URL=

# --- Branding (configurable per deployment) --------------------------------
VITE_BRAND_SHORT_NAME=CPVTS
VITE_BRAND_PRODUCT_NAME=Campus Parking & Vehicle Tracking System
VITE_BRAND_INSTITUTION_NAME=Bharatesh Institute of Technology, Belagavi
# Shows a notice that this is a demonstration deployment, not an official
# institutional system. Set to false only when the institution has authorised it.
VITE_BRAND_SHOW_DEMO_NOTICE=true

# Initial language when the user has not chosen one: en | kn | hi | mr
VITE_DEFAULT_LOCALE=en

# IANA time zone every clock time is shown in. Must match the API's CAMPUS_TIMEZONE.
# VITE_CAMPUS_TIMEZONE=Asia/Kolkata
