# ---------------------------------------------------------------------------
# CPVTS API — environment variables
# Copy to `.env` for local development. Never commit real values.
# Hosted environments (Render, Docker, CI) set these directly.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development
# Optional display name for the environment (e.g. staging). Defaults to NODE_ENV.
APP_ENV=development
PORT=4000
HOST=0.0.0.0

# --- Database (Supabase PostgreSQL) -----------------------------------------
# CPVTS development runs against the shared Supabase PostgreSQL database. Prisma
# (schema + migrations) is the source of truth for its structure; the data in it is
# the project's development data — never reset, drop or truncate it.
#
# Runtime connection used by the API. Use the Supabase *session pooler* string
# (port 5432), which also works for migrations:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Connection used by the Prisma CLI for migrations. Required only when DATABASE_URL
# points at a transaction-mode pooler (Supabase port 6543); leave empty otherwise.
DIRECT_URL=
# The automated tests TRUNCATE every table, so they run against a separate, disposable
# local database and refuse to start against anything else (Supabase included). Set
# this in your shell or CI, not here:
#   TEST_DATABASE_URL=postgresql://cpvts:cpvts@localhost:5432/cpvts_test

# --- Authentication ---------------------------------------------------------
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
# Access-token lifetime in seconds (default 28800 = 8 hours).
JWT_EXPIRES_IN_SECONDS=28800
JWT_ISSUER=cpvts-api
JWT_AUDIENCE=cpvts-web

# --- Web client / CORS ------------------------------------------------------
# Public URL of the web app. Used as the default CORS origin when CORS_ORIGINS is empty.
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed browser and mobile origins (no trailing slashes).
# In local development: http://localhost:5173,http://localhost:4173
# In production on Render with Vercel frontend and future Capacitor Android app:
#   CORS_ORIGINS=https://<your-app>.vercel.app,https://*.vercel.app,capacitor://localhost,http://localhost
CORS_ORIGINS=http://localhost:5173

# Number of reverse-proxy hops to trust for client IPs (Render/most PaaS: 1).
TRUST_PROXY=0

# Failed sign-in attempts allowed per IP per window.
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10
# --- Parking operations ------------------------------------------------------
# IANA time zone of the campus: defines "today" (dashboards) and the current
# hour used for live durations and fee estimates.
CAMPUS_TIMEZONE=Asia/Kolkata
# Lifetime of the temporary slot hold taken during allocation, in seconds.
SLOT_HOLD_SECONDS=15
# How long a Park Now allocation stays held while the user reads it and
# confirms, in seconds. An unconfirmed offer then lapses and the slot returns.
PARK_NOW_HOLD_SECONDS=90
# Occupancy percentage at which a zone raises a "nearly full" alert.
ALERT_NEARLY_FULL_PERCENT=90
# Hours after which an active session raises a "long duration" alert.
ALERT_LONG_DURATION_HOURS=8

# Requests per minute per IP allowed on public (unauthenticated) endpoints.
PUBLIC_RATE_LIMIT_PER_MINUTE=120

# --- Student / Campus Staff accounts and visitors ----------------------------
# Optional: require registration e-mails at these domains (or subdomains),
# comma-separated, e.g. college.edu.in,staff.college.edu.in. Empty allows any.
INSTITUTION_EMAIL_DOMAINS=
# Registrations allowed per IP per hour.
REGISTRATION_RATE_LIMIT_PER_HOUR=10
# Lifetime of a visitor's access to their one parking session, in hours. It is
# also how long after checkout a visitor can still open the receipt.
VISITOR_ACCESS_HOURS=12

# --- Security Staff shifts ---------------------------------------------------
# required: Security Staff need a checked-in shift for gate operations (vehicle entry,
#           checkout payments); administrators can always act (an audited override).
# optional: they may work without a shift; what they do is still attributed to their
#           shift when they have one, and cash taken outside any shift is reported.
SHIFT_ENFORCEMENT=required
# Minutes before a shift starts that its guard may check in.
SHIFT_EARLY_CHECK_IN_MINUTES=60
# Minutes after a shift's end during which the guard can still finish at the gate.
SHIFT_OVERRUN_MINUTES=30

# --- Initial accounts (used only by `npm run db:seed`) ----------------------
# Passwords must be at least 10 characters. Change them after first sign-in.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=CPVTS Administrator
SEED_STAFF_USERNAME=security
SEED_STAFF_PASSWORD=
SEED_STAFF_FULL_NAME=Security Staff
