// CPVTS — persistent relational model (PostgreSQL).
//
// Phase 1 (Foundation) defines the complete core schema from Master Blueprint §37.
// Business workflows that write parking data (allocation, check-in/out, fees,
// payments, receipts) are implemented in later phases.
//
// Conventions:
//   - Tables and columns are snake_case; Prisma models/fields are PascalCase/camelCase.
//   - Primary keys are UUIDs generated by PostgreSQL.
//   - Timestamps are `timestamptz` with millisecond precision.
//   - Money is stored as integer minor units (paise) to avoid floating-point error.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Exactly two login roles (Master Blueprint §3).
enum UserRole {
  ADMIN
  SECURITY_STAFF
  /// Student or Campus Staff parking user (see ParkingUserProfile.category).
  PARKING_USER

  @@map("user_role")
}

/// Only Two-Wheeler and Four-Wheeler vehicles are supported (Master Blueprint §4).
/// Parking-user account category. Visitors never get accounts.
enum ParkingUserCategory {
  STUDENT
  STAFF

  @@map("parking_user_category")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("verification_status")
}

/// Programs offered to students. UG programs run 3 years (6 semesters), PG programs
/// 2 years (4 semesters); the batch (e.g. 2024–2027) is derived from the admission
/// year and the program duration, never typed by the student.
enum AcademicProgram {
  BCA
  BCOM
  BBA
  MCA
  MBA

  @@map("academic_program")
}

/// Lifecycle of a Security Staff duty shift (operational gate duty, not HR).
/// `CHECKED_IN` = checked in before the shift's start; it counts as on duty from the start.
enum ShiftStatus {
  SCHEDULED
  CHECKED_IN
  ACTIVE
  CHECKED_OUT
  CLOSED
  MISSED

  @@map("shift_status")
}

enum VehicleType {
  TWO_WHEELER
  FOUR_WHEELER

  @@map("vehicle_type")
}

/// Category of the vehicle owner for a parking session (Master Blueprint §9).
enum OwnerCategory {
  STAFF
  STUDENT
  VISITOR

  @@map("owner_category")
}

/// Authoritative slot state (Master Blueprint §6). HELD is the short-lived,
/// server-controlled reservation used during allocation (Master Blueprint §11).
enum SlotStatus {
  AVAILABLE
  HELD
  OCCUPIED
  BLOCKED

  @@map("slot_status")
}

/// Lifecycle of a Park Now allocation offer (a temporary slot hold awaiting confirmation).
enum ParkNowOfferStatus {
  OFFERED
  CONFIRMED
  CANCELLED
  EXPIRED

  @@map("park_now_offer_status")
}

/// How a parking session was finalized (checked out).
enum CheckoutChannel {
  /// A Security Staff member at the gate.
  SECURITY
  /// The Student / Campus Staff owner, from their account.
  SELF_SERVICE
  /// A visitor holding the parking slip; no account is involved.
  VISITOR

  @@map("checkout_channel")
}

enum ParkingSessionStatus {
  ACTIVE
  COMPLETED

  @@map("parking_session_status")
}

enum PaymentMethod {
  UPI
  CARD
  CASH
  /// Used only when the authoritative fee is ₹0 (e.g. staff parking).
  NO_CHARGE

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED

  @@map("payment_status")
}

// ---------------------------------------------------------------------------
// Users & audit
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stored normalised (trimmed, lower-case).
  username     String    @unique @db.VarChar(64)
  fullName     String    @map("full_name") @db.VarChar(120)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  /// Incremented to revoke every access token issued to this user (logout, deactivation).
  tokenVersion Int       @default(0) @map("token_version")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  auditLogs          AuditLog[]
  checkedInSessions  ParkingSession[]     @relation("SessionCheckedInBy")
  checkedOutSessions ParkingSession[]     @relation("SessionCheckedOutBy")
  updatedSettings    Setting[]
  parkingProfile     ParkingUserProfile?  @relation("ProfileUser")
  reviewedProfiles   ParkingUserProfile[] @relation("ProfileReviewedBy")
  identityDocuments  IdentityDocument[]
  vehicles           Vehicle[]            @relation("VehicleOwner")
  notifications      Notification[]
  parkNowOffers      ParkNowOffer[]
  ownedSessions      ParkingSession[]     @relation("SessionOwner")
  processedPayments  Payment[]            @relation("PaymentProcessedBy")
  shifts             SecurityShift[]      @relation("ShiftStaff")
  createdShifts      SecurityShift[]      @relation("ShiftCreatedBy")
  receivedHandovers  CashHandover[]       @relation("HandoverReceivedBy")
  resolvedHandovers  CashHandover[]       @relation("HandoverResolvedBy")

  @@index([role, isActive])
  @@map("users")
}

/// Student / Campus Staff details. Category and verification are set only by the server.
model ParkingUserProfile {
  userId                  String              @id @map("user_id") @db.Uuid
  category                ParkingUserCategory
  /// Student USN or employee ID, upper-cased.
  institutionalId         String              @map("institutional_id") @db.VarChar(32)
  /// Lower-cased; used to sign in.
  email                   String              @unique @db.VarChar(254)
  phone                   String              @db.VarChar(20)
  verificationStatus      VerificationStatus  @default(PENDING) @map("verification_status")
  verificationNote        String?             @map("verification_note") @db.VarChar(500)
  verificationSubmittedAt DateTime            @map("verification_submitted_at") @db.Timestamptz(3)
  reviewedAt              DateTime?           @map("reviewed_at") @db.Timestamptz(3)
  reviewedById            String?             @map("reviewed_by_id") @db.Uuid
  preferredLocale         String?             @map("preferred_locale") @db.VarChar(8)
  /// Student academic identity, set together or not at all (a CHECK constraint enforces
  /// this, the semester limit of the program, and that Campus Staff have none). Accounts
  /// created before academic details were collected keep them null until an administrator
  /// fills them in. The batch is derived from `admissionYear` and the program duration.
  program                 AcademicProgram?
  department              String?             @db.VarChar(80)
  admissionYear           Int?                @map("admission_year") @db.SmallInt
  currentSemester         Int?                @map("current_semester") @db.SmallInt
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User  @relation("ProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ProfileReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([category, institutionalId])
  @@index([category, verificationStatus])
  @@index([program, admissionYear, currentSemester])
  @@map("parking_user_profiles")
}

/// Identity document submitted for verification. Visible only to its owner's reviewers (Admin).
model IdentityDocument {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  /// The ID number the user confirmed together with this document.
  institutionalId String   @map("institutional_id") @db.VarChar(32)
  fileName        String   @map("file_name") @db.VarChar(255)
  mimeType        String   @map("mime_type") @db.VarChar(64)
  sizeBytes       Int      @map("size_bytes")
  sha256          String   @db.VarChar(64)
  content         Bytes
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("identity_documents")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null for system-initiated events.
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(64)
  entityType String?  @map("entity_type") @db.VarChar(64)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(255)
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Parking layout: Block -> Zone -> Slot (Master Blueprint §7, §37)
// ---------------------------------------------------------------------------

model ParkingBlock {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(32)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(255)
  /// GPS belongs to the block, not individual slots. Must be real, collected
  /// coordinates — never invented values (Master Blueprint §7).
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  zones ParkingZone[]

  @@map("parking_blocks")
}

model ParkingZone {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockId     String      @map("block_id") @db.Uuid
  code        String      @unique @db.VarChar(32)
  name        String      @db.VarChar(120)
  /// A zone accepts exactly one vehicle type.
  vehicleType VehicleType @map("vehicle_type")
  sortOrder   Int         @default(0) @map("sort_order")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  block ParkingBlock  @relation(fields: [blockId], references: [id], onDelete: Restrict)
  slots ParkingSlot[]

  @@index([blockId])
  @@index([vehicleType, isActive])
  @@map("parking_zones")
}

model ParkingSlot {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zoneId        String     @map("zone_id") @db.Uuid
  /// Human-facing slot ID, e.g. T-01 or F-03. Unique across the campus.
  code          String     @unique @db.VarChar(32)
  status        SlotStatus @default(AVAILABLE)
  /// Optional admin-configured allocation priority (higher is preferred).
  priority      Int        @default(0)
  /// Position in the configured physical layout.
  sortOrder     Int        @default(0) @map("sort_order")
  blockedReason String?    @map("blocked_reason") @db.VarChar(255)
  /// Expiry of a temporary allocation hold; only meaningful while status = HELD.
  holdExpiresAt DateTime?  @map("hold_expires_at") @db.Timestamptz(3)
  /// Secret identifying the allocation attempt that holds the slot; only it may confirm or release.
  holdToken     String?    @map("hold_token") @db.VarChar(64)
  /// A disabled slot is out of service: never allocated and not counted as capacity.
  isEnabled     Boolean    @default(true) @map("is_enabled")
  /// Soft delete. A slot with parking history is archived, never removed, so
  /// historical sessions, receipts and reports keep their slot reference.
  archivedAt    DateTime?  @map("archived_at") @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  zone     ParkingZone      @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  sessions ParkingSession[]
  offers   ParkNowOffer[]

  @@index([zoneId, status])
  @@index([status])
  @@map("parking_slots")
}

// ---------------------------------------------------------------------------
// Vehicles, sessions, payments, receipts (Master Blueprint §8–§35)
// ---------------------------------------------------------------------------

model Vehicle {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stored normalised (upper-case, no separators).
  vehicleNumber String      @unique @map("vehicle_number") @db.VarChar(20)
  vehicleType   VehicleType @map("vehicle_type")
  /// Parking user who registered the vehicle (null for unregistered vehicles).
  ownerUserId   String?     @map("owner_user_id") @db.Uuid
  /// Start of ownership: the owner sees only sessions that began after it.
  ownerSince    DateTime?   @map("owner_since") @db.Timestamptz(3)
  label         String?     @db.VarChar(40)
  isPrimary     Boolean     @default(false) @map("is_primary")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner    User?            @relation("VehicleOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  sessions ParkingSession[]
  offers   ParkNowOffer[]

  @@unique([ownerUserId], map: "vehicles_one_primary_per_owner", where: { isPrimary: true })
  @@index([vehicleType])
  @@index([ownerUserId])
  @@map("vehicles")
}

model ParkingSession {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Unique, hard-to-guess Parking Session Number (Master Blueprint §30).
  sessionNumber  String               @unique @map("session_number") @db.VarChar(32)
  /// Opaque reference encoded in the entry QR; validated server-side (Master Blueprint §31).
  entryReference String               @unique @map("entry_reference") @db.VarChar(128)
  vehicleId      String               @map("vehicle_id") @db.Uuid
  slotId         String               @map("slot_id") @db.Uuid
  /// Snapshot of the vehicle type at check-in.
  vehicleType    VehicleType          @map("vehicle_type")
  ownerCategory  OwnerCategory        @map("owner_category")
  status         ParkingSessionStatus @default(ACTIVE)
  /// Whole-hour competition input model (0–23).
  entryHour      Int                  @map("entry_hour") @db.SmallInt
  exitHour       Int?                 @map("exit_hour") @db.SmallInt
  entryAt        DateTime             @map("entry_at") @db.Timestamptz(3)
  exitAt         DateTime?            @map("exit_at") @db.Timestamptz(3)
  durationHours  Int?                 @map("duration_hours")
  /// Authoritative fee from the single backend fee engine, in paise.
  feeAmountPaise Int?                 @map("fee_amount_paise")
  /// Fee breakdown (`FeeBreakdown` in @cpvts/shared) frozen at finalization.
  feeBreakdown   Json?                @map("fee_breakdown")
  checkedInById  String               @map("checked_in_by_id") @db.Uuid
  checkedOutById String?              @map("checked_out_by_id") @db.Uuid
  /// Who finalized the session. Final checkout is gate-controlled, so new sessions are
  /// finalized by SECURITY only; SELF_SERVICE and VISITOR remain for sessions finalized
  /// before the gate-controlled model (a VISITOR checkout has no `checkedOutById`).
  checkedOutVia  CheckoutChannel?     @map("checked_out_via")
  /// The account that owned the vehicle when the session began (null for an unregistered
  /// vehicle). The owner sees exactly the sessions that carry their id, even after they
  /// release the vehicle; a later owner of the same plate never sees them.
  ownerUserId    String?              @map("owner_user_id") @db.Uuid
  /// "Ready to leave": set by the owner or visitor from the app. It never releases the slot;
  /// only the gate checkout (payment, receipt) completes the session.
  exitRequestedAt DateTime?           @map("exit_requested_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicle      Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  slot         ParkingSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  checkedInBy  User        @relation("SessionCheckedInBy", fields: [checkedInById], references: [id], onDelete: Restrict)
  checkedOutBy User?       @relation("SessionCheckedOutBy", fields: [checkedOutById], references: [id], onDelete: Restrict)
  owner        User?       @relation("SessionOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  payments     Payment[]
  receipt      Receipt?
  exitCodes    ExitCode[]

  /// Database-level guarantee: a vehicle can have at most one ACTIVE session.
  @@unique([vehicleId], map: "parking_sessions_one_active_per_vehicle", where: { status: "ACTIVE" })
  /// Database-level guarantee: a slot can hold at most one ACTIVE session.
  @@unique([slotId], map: "parking_sessions_one_active_per_slot", where: { status: "ACTIVE" })
  @@index([vehicleId, createdAt])
  @@index([slotId, createdAt])
  @@index([status, entryAt])
  @@index([exitAt])
  @@index([ownerUserId, entryAt])
  @@map("parking_sessions")
}

/// Short-lived 6-digit exit code that lets the gate find an ACTIVE session when the QR cannot be
/// scanned. Only a keyed hash is stored; a session has at most one live code (re-issuing replaces
/// it) and finalizing the checkout deletes it. The code finds the session — it never completes it.
model ExitCode {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  /// HMAC-SHA256 of the code (never the code itself).
  codeHash  String   @map("code_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  session ParkingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([codeHash, expiresAt])
  @@index([sessionId])
  @@map("exit_codes")
}

model Payment {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId     String        @map("session_id") @db.Uuid
  /// Mock transaction identifier shown to the user (Master Blueprint §28).
  transactionId String        @unique @map("transaction_id") @db.VarChar(32)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amountPaise   Int           @map("amount_paise")
  /// Exit hour the amount was calculated for; finalization uses the same value.
  exitHour      Int           @map("exit_hour") @db.SmallInt
  /// Always true: payments are processed by the simulated (test/demo) provider.
  isSimulated   Boolean       @default(true) @map("is_simulated")
  failureReason String?       @map("failure_reason") @db.VarChar(64)
  paidAt        DateTime?     @map("paid_at") @db.Timestamptz(3)
  /// Accountability: the Security Staff member (or administrator) who took this payment.
  /// Set when the payment is finalized; every PAID payment has one.
  processedById String?       @map("processed_by_id") @db.Uuid
  /// The duty shift the payment belongs to: the operator's active shift when the payment
  /// was created. Null for administrator overrides and for payments taken before shifts.
  /// Cash payments of a shift add up to the cash that shift must hand over.
  shiftId       String?       @map("shift_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  session     ParkingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  processedBy User?          @relation("PaymentProcessedBy", fields: [processedById], references: [id], onDelete: Restrict)
  shift       SecurityShift? @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  receipt     Receipt?

  /// Database-level guarantee: a session can be paid at most once.
  @@unique([sessionId], map: "payments_one_paid_per_session", where: { status: "PAID" })
  /// Database-level guarantee: at most one open (pending/processing) payment per session.
  @@unique([sessionId], map: "payments_one_open_per_session", where: raw("status = ANY (ARRAY['PENDING'::payment_status, 'PROCESSING'::payment_status])"))
  @@index([sessionId, createdAt])
  @@index([status, paidAt])
  @@index([shiftId, status, method])
  @@index([processedById, paidAt])
  @@map("payments")
}

model Receipt {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Permanent receipt number, distinct from the session number (Master Blueprint §32).
  receiptNumber         String   @unique @map("receipt_number") @db.VarChar(32)
  /// Opaque, non-guessable reference encoded in the receipt QR (Master Blueprint §33).
  verificationReference String   @unique @map("verification_reference") @db.VarChar(128)
  sessionId             String   @unique @map("session_id") @db.Uuid
  paymentId             String   @unique @map("payment_id") @db.Uuid
  amountPaise           Int      @map("amount_paise")
  issuedAt              DateTime @map("issued_at") @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  session ParkingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  payment Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([issuedAt])
  @@map("receipts")
}

// ---------------------------------------------------------------------------
// Park Now offers and notifications (Parking User self-service)
// ---------------------------------------------------------------------------

/// A server-side allocation for a Student / Campus Staff member's vehicle. The
/// slot is HELD for the offer; confirming turns the hold into an ACTIVE session,
/// letting it lapse (or cancelling) returns the slot to AVAILABLE.
model ParkNowOffer {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  vehicleId  String             @map("vehicle_id") @db.Uuid
  slotId     String             @map("slot_id") @db.Uuid
  /// Secret of the slot hold backing this offer (see ParkingSlot.holdToken).
  holdToken  String             @map("hold_token") @db.VarChar(64)
  status     ParkNowOfferStatus @default(OFFERED)
  /// `AllocationExplanation` (@cpvts/shared) produced by the allocation engine.
  allocation Json
  expiresAt  DateTime           @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  slot    ParkingSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  /// Database-level guarantee: a user holds at most one open offer, so Park Now cannot hoard slots.
  @@unique([userId], map: "park_now_offers_one_open_per_user", where: { status: "OFFERED" })
  @@index([status, expiresAt])
  @@index([slotId])
  @@map("park_now_offers")
}

// ---------------------------------------------------------------------------
// Security Staff shifts and cash accountability (operational gate duty, not HR)
// ---------------------------------------------------------------------------

/// A reusable shift pattern an administrator can create and edit (e.g. Morning 08:00–16:00).
/// Assignments copy the name and times, so editing a template never rewrites history.
model ShiftTemplate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(60)
  /// Minutes after midnight (campus time). An end at or before the start means the shift
  /// ends the next day: 16:00–00:00 is start 960, end 0; 22:00–06:00 is start 1320, end 360.
  startMinute Int      @map("start_minute") @db.SmallInt
  endMinute   Int      @map("end_minute") @db.SmallInt
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shifts SecurityShift[]

  @@map("shift_templates")
}

/// One Security Staff member on duty for one shift on one date, optionally at a gate.
/// Gate operations and payments taken during the shift are attributed to it, which is
/// what makes the cash a guard collected their responsibility until it is handed over.
model SecurityShift {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffId      String      @map("staff_id") @db.Uuid
  templateId   String?     @map("template_id") @db.Uuid
  /// Copy of the template name when the shift was assigned.
  shiftName    String      @map("shift_name") @db.VarChar(60)
  /// Campus calendar date on which the shift starts.
  shiftDate    DateTime    @map("shift_date") @db.Date
  startsAt     DateTime    @map("starts_at") @db.Timestamptz(3)
  /// An administrator may extend or correct this while the shift is open.
  endsAt       DateTime    @map("ends_at") @db.Timestamptz(3)
  /// Optional gate or parking location, e.g. "Main Gate".
  gate         String?     @db.VarChar(60)
  status       ShiftStatus @default(SCHEDULED)
  checkedInAt  DateTime?   @map("checked_in_at") @db.Timestamptz(3)
  checkedOutAt DateTime?   @map("checked_out_at") @db.Timestamptz(3)
  /// Set when the cash handover is reconciled; a shift with an unresolved discrepancy is not closed.
  closedAt     DateTime?   @map("closed_at") @db.Timestamptz(3)
  note         String?     @db.VarChar(255)
  createdById  String?     @map("created_by_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  staff     User           @relation("ShiftStaff", fields: [staffId], references: [id], onDelete: Restrict)
  template  ShiftTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy User?          @relation("ShiftCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  payments  Payment[]
  handover  CashHandover?

  @@index([staffId, startsAt])
  @@index([shiftDate, status])
  @@index([status, endsAt])
  @@map("security_shifts")
}

/// The cash a guard hands over when a shift ends, counted and received by an administrator
/// (the cash custodian). Expected cash is what the system recorded; actual is what was
/// handed over. A difference needs a reason and an administrator's review before the
/// shift counts as financially closed.
model CashHandover {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shiftId           String    @unique @map("shift_id") @db.Uuid
  /// PAID cash payments attributed to the shift when the handover was recorded.
  expectedCashPaise Int       @map("expected_cash_paise")
  actualCashPaise   Int       @map("actual_cash_paise")
  /// actual − expected: negative = short, positive = over, zero = balanced.
  differencePaise   Int       @map("difference_paise")
  cashTransactions  Int       @map("cash_transactions")
  /// UPI and card collections of the shift (kept separate from cash).
  digitalPaise      Int       @map("digital_paise")
  /// Why the cash does not match; required when the difference is not zero.
  note              String?   @db.VarChar(500)
  receivedById      String    @map("received_by_id") @db.Uuid
  receivedAt        DateTime  @map("received_at") @db.Timestamptz(3)
  /// An administrator's review of a mismatch.
  resolutionNote    String?   @map("resolution_note") @db.VarChar(500)
  resolvedById      String?   @map("resolved_by_id") @db.Uuid
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  shift      SecurityShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  receivedBy User          @relation("HandoverReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  resolvedBy User?         @relation("HandoverResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([differencePaise, resolvedAt])
  @@map("cash_handovers")
}

/// Lightweight in-app notification. `kind` + `params` are translated by the client.
model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// One of `NOTIFICATION_KINDS` (@cpvts/shared).
  kind      String    @db.VarChar(40)
  params    Json?
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}
